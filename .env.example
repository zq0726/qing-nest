# ============================================================
# 环境变量模板
# ============================================================
# 使用方法：
#   1. cp .env.example .env.development          # 非敏感配置
#   2. cp .env.example .env.development.local     # 敏感凭据（密码/密钥/SMTP）
#
# 配置分层（.local 优先级更高，覆盖同名变量）：
#   .env.{NODE_ENV}          → 非敏感默认值（HOST/PORT/开关等）
#   .env.{NODE_ENV}.local    → 敏感凭据（密码/密钥/SMTP授权码），不提交 git
#
# 两者均被 .gitignore 忽略，仅 .env.example 会被提交。
# ============================================================

# 应用配置
NODE_ENV=development
PORT=3000

# CORS 允许的源（逗号分隔）
CORS_ORIGINS=http://localhost:5173

# MySQL 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=qing_nest

# Redis 配置
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT 配置
JWT_SECRET=
JWT_EXPIRES_IN=7d

# 定时任务
SCHEDULE_ENABLED=true

# WebSocket CORS 允许的源（留空表示不限制，生产环境必须指定）
WS_CORS_ORIGINS=

# 邮件 SMTP 配置
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
